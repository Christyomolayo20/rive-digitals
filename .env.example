# ============================================================================
# RIVE DIGITALS — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to `.env.local` for local development or configure in your
# hosting provider (e.g., Vercel Environment Variables).
# Never commit real API keys or production secrets to version control.
# ============================================================================

# 1. PUBLIC SITE CONFIGURATION
NEXT_PUBLIC_SITE_URL="https://rivedigitals.com"
NEXT_PUBLIC_CONTACT_EMAIL="hello@rivedigitals.com"
NEXT_PUBLIC_CONTACT_PHONE="+2348000000000"
NEXT_PUBLIC_WHATSAPP_NUMBER="2348000000000"

# 2. ADMIN STUDIO PASSCODE (/admin)
# Passcode used to unlock the Admin Studio at /admin
ADMIN_PASSCODE="R1vedigit@l$"

# 3. SUPABASE DATABASE & CMS INTEGRATION
# Connect your Supabase project for live Enquiries, Portfolio Projects & Services
# Run `supabase/schema.sql` in your Supabase SQL Editor to create tables & RLS policies.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# 4. TRANSACTIONAL EMAIL INTEGRATION (RESEND)
# Optional or primary email notification channel for new enquiries
RESEND_API_KEY=""
ENQUIRY_FROM_EMAIL="Rive Digitals Website <notifications@rivedigitals.com>"
ENQUIRY_TO_EMAIL="hello@rivedigitals.com"

# 5. OPTIONAL WEBHOOK / CRM INTEGRATION
# Alternative or supplementary destination for enquiries (e.g., Make, Zapier, Slack, HubSpot)
ENQUIRY_WEBHOOK_URL=""

# 6. PRIVACY-CONSCIOUS ANALYTICS (OPTIONAL)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# 7. DEVELOPMENT MODE ALLOWANCE
ALLOW_LOCAL_ENQUIRY_SPOOL="true"
